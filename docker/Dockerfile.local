FROM golang:1.26-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=3.6.1-local
ARG BUILD_DATE
ARG GIT_COMMIT

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build \
      -ldflags "-s -w -X github.com/haierkeys/fast-note-sync-service/internal/app.Version=${VERSION} -X github.com/haierkeys/fast-note-sync-service/internal/app.GitTag=${GIT_COMMIT} -X github.com/haierkeys/fast-note-sync-service/internal/app.BuildTime=${BUILD_DATE}" \
      -o /out/fast-note-sync-service \
      .

FROM woahbase/alpine-glibc:latest

ARG VERSION=3.6.1-local
ARG BUILD_DATE
ARG GIT_COMMIT

LABEL name="fast-note-sync-service"
LABEL version=${VERSION}
LABEL org.opencontainers.image.title="Fast Note Sync Service"
LABEL org.opencontainers.image.created=${BUILD_DATE}
LABEL org.opencontainers.image.version=${VERSION}
LABEL org.opencontainers.image.revision=${GIT_COMMIT}
LABEL org.opencontainers.image.licenses="Apache-2.0"

ENV TZ=UTC
ENV P_NAME=fast-note-sync
ENV P_BIN=fast-note-sync-service

RUN apk --no-cache add --no-progress \
      libstdc++ curl ca-certificates bash gcompat tzdata \
    && mkdir -p /fast-note-sync

EXPOSE 9000 9001
VOLUME /fast-note-sync/config
VOLUME /fast-note-sync/storage

COPY --from=builder /out/fast-note-sync-service /fast-note-sync/fast-note-sync-service
COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh /fast-note-sync/fast-note-sync-service

ENTRYPOINT ["/entrypoint.sh"]
